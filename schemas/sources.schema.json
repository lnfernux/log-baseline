{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lnfernux/log-baseline/schemas/sources.schema.json",
  "title": "Log baseline source provenance",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "revision", "observedOn", "appliesTo", "scope"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "revision": { "type": "string", "minLength": 1 },
          "observedOn": { "type": "string", "format": "date" },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*\\.json$" }
          },
          "scope": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
