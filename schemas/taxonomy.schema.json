{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lnfernux/log-baseline/schemas/taxonomy.schema.json",
  "title": "Log baseline taxonomy",
  "type": "object",
  "required": ["schemaVersion", "domains", "logTypes", "categoryMappings", "tableOverrides"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "logTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "categoryMappings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/assignment" }
    },
    "tableOverrides": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/assignment" }
    }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "required": ["domainId", "logTypeId"],
      "properties": {
        "domainId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "logTypeId": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
