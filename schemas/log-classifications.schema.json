{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lnfernux/log-baseline/schemas/log-classifications.schema.json",
  "title": "Log baseline classifications",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["tableName", "connector", "classification", "category", "description", "keywords", "mitreSources", "recommendedTier", "isFree", "recommendedRetentionDays", "sourceIds"],
    "properties": {
      "tableName": { "type": "string", "minLength": 1 },
      "connector": { "type": "string", "minLength": 1 },
      "classification": { "enum": ["primary", "secondary"] },
      "category": {
        "enum": [
          "Application Logs", "Cloud Control Plane", "Cloud Security", "Configuration Management",
          "Container & Kubernetes", "Data Platform", "Data Security", "Email Security",
          "Endpoint Detection", "Endpoint Telemetry", "Identity & Access", "Infrastructure Diagnostics",
          "IoT/OT Security", "Network Flow", "Network Security", "Platform Health",
          "Posture Management", "SAP Security", "Security Alerts", "Storage Access",
          "Threat Intelligence", "Vulnerability Management"
        ]
      },
      "description": { "type": "string", "minLength": 1 },
      "keywords": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "mitreSources": { "type": "array", "items": { "type": "string" } },
      "recommendedTier": { "enum": ["analytics", "datalake"] },
      "valueRule": { "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8", "C9"] },
      "tierRule": { "enum": ["T1", "T2", "T3", "T4", "T5"] },
      "volumeClass": { "enum": ["low", "medium", "high", "very-high"] },
      "volumeDriver": {
        "enum": [
          "alert", "admin-action", "sign-in", "token-sign-in", "activity", "message",
          "endpoint-event", "os-event", "connection", "dns-query", "web-request",
          "api-request", "data-access", "snapshot", "indicator", "metric", "application-trace"
        ]
      },
      "isFree": { "type": "boolean" },
      "recommendedRetentionDays": { "enum": [90, 180, 365] },
      "status": { "enum": ["deprecated", "legacy"] },
      "replacedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "xdrStreamable": { "type": "boolean" },
      "defenderNative": { "type": "boolean" },
      "logAnalyticsTable": { "const": false },
      "platform": { "type": "boolean" },
      "domainId": { "type": "string", "minLength": 1 },
      "logTypeId": { "type": "string", "minLength": 1 },
      "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
    },
    "additionalProperties": false,
    "dependentRequired": {
      "status": ["replacedBy"],
      "replacedBy": ["status"]
    }
  }
}
